{
  "manifestVersion": 5,
  "id": "com.dnlpark.canvastimelapse",
  "name": "Canvas Timelapse",
  "version": "1.0.5",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "canvasTimelapsePanel",
      "label": {
        "default": "Canvas Timelapse"
      },
      "minimumSize": {
        "width": 230,
        "height": 320
      },
      "maximumSize": {
        "width": 1000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 260,
        "height": 460
      },
      "preferredFloatingSize": {
        "width": 300,
        "height": 520
      }
    }
  ]
}
